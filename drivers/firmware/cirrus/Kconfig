config FW_CS_DSP
	tristate
	default n

config FW_CL_DSP
	tristate
	default n

menu "CL_DSP Firmware Driver"
	depends on FW_CL_DSP

config FW_CL_DSP_MAX_TRANSMISSION_LENGTH
	int "Max Transmission Length"
	default 4096
	range 128 4096
	help
	  Maximum write length in bytes per I2C/SPI
	  transaction. Use to limit length of blocking
	  writes in case of control port contention.

endmenu
